  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint --max-warnings=0 && eslint \"{app,components,examples,hooks,lib}/**/*.{ts,tsx}\"",
    "format": "prettier --write \"app/**/*.{ts,tsx,css}\" \"components/**/*.{ts,tsx,css}\" \"examples/**/*.{ts,tsx}\" \"lib/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"app/**/*.{ts,tsx,css}\" \"components/**/*.{ts,tsx,css}\" \"examples/**/*.{ts,tsx}\" \"lib/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "lint:fix": "oxlint --fix && eslint --fix \"{app,components,examples,hooks,lib}/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@fumadocs/story": "1.2.0",
    "@remixicon/react": "4.9.0",
    "@types/mdx": "2.0.14",
    "@workspace/ui": "workspace:*",
    "fumadocs-core": "16.15.13",
    "fumadocs-mdx": "15.4.3",
    "fumadocs-ui": "16.15.13",
    "next": "16.3.6",
    "next-themes": "0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "2.0.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "10.11.0",
    "oxlint": "1.85.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
