{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build",
        "@workspace/ui#registry"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "format": {
      "dependsOn": [
        "^format"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "registry": {
      "cache": false,
      "inputs": [
        "src/**",
        "scripts/**",
        "registry.json"
      ]
    }
  },
  "globalDependencies": [
    ".oxlintrc.json",
    "tsconfig.json",
    ".gitattributes"
  ]
}
