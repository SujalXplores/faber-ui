# pnpm config — Faber UI
# Reproducible, strict, fast installs.

# Pin exact versions when adding/saving deps (no ^/~ prefixes).
save-exact=true
# Belt-and-suspenders: strip any range prefix pnpm might otherwise add.
save-prefix=''

# Use the lockfile as the source of truth; fail CI if it's out of date.
frozen-lockfile=true

# Resolve workspace packages locally wherever possible.
link-workspace-packages=true

# Prefer the pnpm store's hard links for speed and disk efficiency.
package-import-method=hardlink

# Fail on engine mismatch (Node version).
engine-strict=true

# Security: don't run dependency lifecycle scripts unless allowlisted
# (see allowBuilds in pnpm-workspace.yaml).
ignore-scripts=true

# Faster, deterministic resolution.
resolution-mode=highest
prefer-offline=true

# Surface peer-dependency problems instead of silently auto-installing.
auto-install-peers=false
strict-peer-dependencies=true
